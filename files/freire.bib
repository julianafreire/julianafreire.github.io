@article{stober@pnas2025,
author = {Clintin P. Davis-Stober  and Alexandra Sarafoglou  and Balazs Aczel  and Suyog H. Chandramouli  and Timothy M. Errington  and Sarahanne M. Field  and Ayelet Fishbach  and Juliana Freire  and John P. A. Ioannidis  and Klaus Oberauer  and Franco Pestilli  and Susanne Ressl  and Daniel J. Schad  and Judith ter Schure  and Katya Tentori  and Don van Ravenzwaaij  and Joachim Vandekerckhove  and Odd Erik Gundersen },
title = {How can we make sound replication decisions?},
journal = {Proceedings of the National Academy of Sciences},
volume = {122},
number = {5},
pages = {e2401236121},
year = {2025},
doi = {10.1073/pnas.2401236121},
URL = {https://www.pnas.org/doi/abs/10.1073/pnas.2401236121},
eprint = {https://www.pnas.org/doi/pdf/10.1073/pnas.2401236121},
abstract = {Replication and the reported crises impacting many fields of research have become a focal point for the sciences. This has led to reforms in publishing, methodological design and reporting, and increased numbers of experimental replications coordinated across many laboratories. While replication is rightly considered an indispensable tool of science, financial resources and researchers’ time are quite limited. In this perspective, we examine different values and attitudes that scientists can consider when deciding whether to replicate a finding and how. We offer a conceptual framework for assessing the usefulness of various replication tools, such as preregistration.}}



